<section class="runyth-fog-policy-dashboard">
  <header class="policy-summary">
    <div class="summary-heading">
      <div class="summary-copy">
        <h2>{{localize policyStatusKey}}</h2>
        <p>{{localize "RUNYTH_FOG_POLICY.Dashboard.Intro"}}</p>
      </div>
      <div class="operation-state" role="status" aria-live="polite" data-operation-status>
        {{localize "RUNYTH_FOG_POLICY.Dashboard.Ready"}}
      </div>
    </div>

    <div class="summary-grid" role="list">
      <div role="listitem"><strong data-summary="total">{{audit.total}}</strong><span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Total"}}</span></div>
      <div role="listitem"><strong data-summary="managed">{{audit.managed}}</strong><span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Managed"}}</span></div>
      <div role="listitem"><strong data-summary="compliant">{{audit.compliant}}</strong><span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Compliant"}}</span></div>
      <div role="listitem"><strong data-summary="nonCompliant">{{audit.nonCompliant}}</strong><span>{{localize "RUNYTH_FOG_POLICY.Dashboard.NonCompliant"}}</span></div>
      <div role="listitem"><strong data-summary="exempt">{{audit.exempt}}</strong><span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Exempt"}}</span></div>
      <div role="listitem"><strong data-summary="visible">{{audit.total}}</strong><span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Visible"}}</span></div>
      <div role="listitem"><strong data-summary="selected">0</strong><span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Selected"}}</span></div>
    </div>
  </header>

  <nav class="policy-actions compact-actions" aria-label="{{localize 'RUNYTH_FOG_POLICY.Dashboard.Actions'}}">
    <button type="button" data-action="audit"><i class="fa-solid fa-rotate" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.Audit"}}</button>
    <button type="button" data-action="repairSelected" data-requires-selection data-requires-policy><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.RepairSelected"}}</button>
    <button type="button" data-action="repairAll" data-requires-policy><i class="fa-solid fa-toolbox" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.RepairAll"}}</button>
    <button type="button" data-action="exemptSelected" data-requires-selection data-requires-exemptions><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.ExemptSelected"}}</button>
    <button type="button" data-action="manageSelected" data-requires-selection data-requires-exemptions><i class="fa-solid fa-eye-slash" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.ManageSelected"}}</button>
    <button type="button" class="danger" data-action="purgeSelected" data-requires-selection><i class="fa-solid fa-eraser" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.PurgeSelected"}}</button>
  </nav>

  <section class="scene-tools" aria-label="{{localize 'RUNYTH_FOG_POLICY.Dashboard.Filters'}}">
    <div class="search-toolbar">
      <div class="search-control">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" data-filter="scene-search" placeholder="{{localize 'RUNYTH_FOG_POLICY.Dashboard.SearchPlaceholder'}}" autocomplete="off" spellcheck="false" aria-label="{{localize 'RUNYTH_FOG_POLICY.Dashboard.Search'}}">
      </div>
      <button type="button" class="folder-toggle" data-action="toggleFolders" aria-expanded="false" aria-controls="runyth-fog-policy-folder-panel">
        <i class="fa-solid fa-folder-tree" aria-hidden="true"></i>
        <span>{{localize "RUNYTH_FOG_POLICY.Dashboard.SceneFolders"}}</span>
        <span class="count-badge" data-folder-selected-count hidden>0</span>
      </button>
      <button type="button" class="icon-button" data-action="resetFilters" title="{{localize 'RUNYTH_FOG_POLICY.Dashboard.ResetFilters'}}" aria-label="{{localize 'RUNYTH_FOG_POLICY.Dashboard.ResetFilters'}}"><i class="fa-solid fa-filter-circle-xmark" aria-hidden="true"></i></button>
    </div>

    <div class="quick-filter-bar">
      <span class="filter-group-label">{{localize "RUNYTH_FOG_POLICY.Dashboard.StatusLabel"}}</span>
      <label class="filter-chip"><input type="checkbox" data-filter-group="status" value="compliant"> <span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Status.compliant"}}</span></label>
      <label class="filter-chip"><input type="checkbox" data-filter-group="status" value="nonCompliant"> <span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Status.nonCompliant"}}</span></label>
      <label class="filter-chip"><input type="checkbox" data-filter-group="status" value="exempt"> <span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Status.exempt"}}</span></label>
      <span class="filter-divider" aria-hidden="true"></span>
      <span class="filter-group-label">{{localize "RUNYTH_FOG_POLICY.Dashboard.FogExploration"}}</span>
      <label class="filter-chip"><input type="checkbox" data-filter-group="fog" value="enabled"> <span>{{localize "RUNYTH_FOG_POLICY.Common.Enabled"}}</span></label>
      <label class="filter-chip"><input type="checkbox" data-filter-group="fog" value="disabled"> <span>{{localize "RUNYTH_FOG_POLICY.Common.Disabled"}}</span></label>
      <label class="filter-chip"><input type="checkbox" data-filter="selected-only"> <span>{{localize "RUNYTH_FOG_POLICY.Dashboard.SelectedOnly"}}</span></label>
    </div>

    <p class="search-help">{{localize "RUNYTH_FOG_POLICY.Dashboard.SearchHelp"}}</p>

    <div class="folder-drawer" id="runyth-fog-policy-folder-panel" data-folder-panel hidden>
      <div class="folder-toolbar">
        <div class="search-control compact-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" data-filter="folder-search" placeholder="{{localize 'RUNYTH_FOG_POLICY.Dashboard.FolderSearchPlaceholder'}}" autocomplete="off" spellcheck="false">
        </div>
        <label class="compact-check"><input type="checkbox" data-filter="include-descendants" checked> {{localize "RUNYTH_FOG_POLICY.Dashboard.IncludeDescendants"}}</label>
        <span class="folder-visible-summary"><span data-folder-visible-count>0</span> {{localize "RUNYTH_FOG_POLICY.Dashboard.FoldersVisible"}}</span>
      </div>
      <div class="folder-virtual-list" data-virtual-list="folders" role="listbox" aria-label="{{localize 'RUNYTH_FOG_POLICY.Dashboard.SceneFolders'}}"></div>
    </div>
  </section>

  <section class="selection-toolbar" aria-label="{{localize 'RUNYTH_FOG_POLICY.Dashboard.Selection'}}">
    <strong>{{localize "RUNYTH_FOG_POLICY.Dashboard.Selection"}}</strong>
    <div class="selection-actions">
      <button type="button" data-action="selectFiltered"><i class="fa-solid fa-check-double" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.SelectFiltered"}}</button>
      <button type="button" data-action="invertFiltered"><i class="fa-solid fa-right-left" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.InvertFiltered"}}</button>
      <button type="button" data-action="clearSelection"><i class="fa-solid fa-xmark" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.ClearSelection"}}</button>
    </div>
  </section>

  <main class="scene-panel">
    <div class="scene-table-header" role="row">
      <span></span>
      <span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Scene"}}</span>
      <span class="scene-fog-header">{{localize "RUNYTH_FOG_POLICY.Dashboard.FogExploration"}}</span>
      <span class="scene-status-header">{{localize "RUNYTH_FOG_POLICY.Dashboard.StatusLabel"}}</span>
      <span>{{localize "RUNYTH_FOG_POLICY.Dashboard.Exemption"}}</span>
    </div>
    <div class="scene-virtual-list" data-virtual-list="scenes" role="rowgroup" aria-label="{{localize 'RUNYTH_FOG_POLICY.Dashboard.SceneList'}}"></div>
  </main>

  <section class="transfer-panel">
    <details>
      <summary><i class="fa-solid fa-box-archive" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.BackupAndTransfer"}}</summary>
      <div class="transfer-grid">
        <fieldset>
          <legend>{{localize "RUNYTH_FOG_POLICY.Dashboard.ExportOptions"}}</legend>
          <label><input type="radio" name="backup-target" value="selected" checked> {{localize "RUNYTH_FOG_POLICY.Dashboard.TargetSelected"}}</label>
          <label><input type="radio" name="backup-target" value="filtered"> {{localize "RUNYTH_FOG_POLICY.Dashboard.TargetFiltered"}}</label>
          <label><input type="checkbox" data-backup-option="settings" checked> {{localize "RUNYTH_FOG_POLICY.Dashboard.IncludeGlobalSettings"}}</label>
          <div class="button-row">
            <button type="button" data-action="exportBackup"><i class="fa-solid fa-file-export" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.ExportBackup"}}</button>
            <button type="button" data-action="exportSelection"><i class="fa-solid fa-list-check" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.ExportSelection"}}</button>
          </div>
        </fieldset>

        <fieldset>
          <legend>{{localize "RUNYTH_FOG_POLICY.Dashboard.ImportBackupOptions"}}</legend>
          <label><input type="checkbox" data-import-option="exemptions" checked> {{localize "RUNYTH_FOG_POLICY.Dashboard.RestoreExemptions"}}</label>
          <label><input type="checkbox" data-import-option="fog" checked> {{localize "RUNYTH_FOG_POLICY.Dashboard.RestoreFogState"}}</label>
          <label><input type="checkbox" data-import-option="settings"> {{localize "RUNYTH_FOG_POLICY.Dashboard.RestoreGlobalSettings"}}</label>
          <label><input type="checkbox" data-import-option="safety-backup" checked> {{localize "RUNYTH_FOG_POLICY.Dashboard.CreateSafetyBackup"}}</label>
          <label><input type="checkbox" data-import-option="select" checked> {{localize "RUNYTH_FOG_POLICY.Dashboard.SelectImportedScenes"}}</label>
          <button type="button" data-action="importBackup"><i class="fa-solid fa-file-import" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.ImportBackup"}}</button>
        </fieldset>

        <fieldset>
          <legend>{{localize "RUNYTH_FOG_POLICY.Dashboard.SelectionTransfer"}}</legend>
          <label><input type="checkbox" data-selection-import-option="replace" checked> {{localize "RUNYTH_FOG_POLICY.Dashboard.ReplaceSelection"}}</label>
          <button type="button" data-action="importSelection"><i class="fa-solid fa-list-check" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.ImportSelection"}}</button>
          <p class="microcopy">{{localize "RUNYTH_FOG_POLICY.Dashboard.TransferHelp"}}</p>
        </fieldset>
      </div>
    </details>
  </section>

  <p class="warning-note"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>{{localize "RUNYTH_FOG_POLICY.Dashboard.PurgeWarning"}}</p>

  <input type="file" accept="application/json,.json" data-file-input="backup" hidden>
  <input type="file" accept="application/json,.json" data-file-input="selection" hidden>
</section>
